# Database Connection (Local Docker or AWS RDS PostgreSQL)
DATABASE_URL=postgresql+psycopg://accommodation:accommodation@localhost:5432/campus_mobility_accommodation

# AWS RDS PostgreSQL Deployment Example:
# DATABASE_URL=postgresql+psycopg://dbadmin:MySecurePass123@accommodation-db.c0123456789.ap-south-1.rds.amazonaws.com:5432/campus_mobility_accommodation?sslmode=require
# Or configure discrete RDS fields:
# AWS_RDS_ENDPOINT=accommodation-db.c0123456789.ap-south-1.rds.amazonaws.com
# AWS_RDS_USER=dbadmin
# AWS_RDS_PASSWORD=MySecurePass123
# AWS_RDS_DB=campus_mobility_accommodation
# AWS_RDS_PORT=5432
# AWS_RDS_SSLMODE=require

HOLD_MINUTES=30
EXPIRY_JOB_SECONDS=60
ENVIRONMENT=dev
JWT_SECRET=change-me-in-production
JWT_EXPIRE_MINUTES=60
OTP_TTL_SECONDS=600
EMAIL_BACKEND=console
CORS_ORIGINS=http://localhost:3001,http://127.0.0.1:3001,http://localhost:5173,http://127.0.0.1:5173
