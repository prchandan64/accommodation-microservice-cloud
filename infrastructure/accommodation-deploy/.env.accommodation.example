# Accommodation Microservice — Production Environment Template
# Copy to .env.accommodation on the target host and populate real secrets securely.
# NEVER commit .env.accommodation to Git.

ENVIRONMENT=production

# Required: >= 32-byte cryptographically random secret
JWT_SECRET=REPLACE_WITH_32_PLUS_CHAR_RANDOM_SECRET
JWT_EXPIRE_MINUTES=60
OTP_TTL_SECONDS=600

# Option A: Full PostgreSQL connection string (Amazon RDS PostgreSQL 16 with TLS)
# DATABASE_URL=postgresql+psycopg://dbuser:REPLACE_PASSWORD@your-rds-endpoint.region.rds.amazonaws.com:5432/campus_mobility_accommodation?sslmode=verify-full&sslrootcert=/etc/ssl/certs/rds-ca-bundle.pem

# Option B: Discrete Amazon RDS fields (consumed by settings.get_effective_database_url())
AWS_RDS_ENDPOINT=your-rds-endpoint.region.rds.amazonaws.com
AWS_RDS_USER=accommodation_app
AWS_RDS_PASSWORD=REPLACE_WITH_STRONG_RDS_PASSWORD
AWS_RDS_DB=campus_mobility_accommodation
AWS_RDS_PORT=5432
AWS_RDS_SSLMODE=require

# Production Email (console is rejected when ENVIRONMENT != dev)
EMAIL_BACKEND=smtp
SMTP_HOST=email-smtp.ap-south-1.amazonaws.com
SMTP_PORT=587
SMTP_USER=REPLACE_WITH_SMTP_USERNAME
SMTP_PASSWORD=REPLACE_WITH_SMTP_PASSWORD
SMTP_FROM=no-reply@your-domain.example

# CORS Allowlist (comma-separated HTTPS origins only; no wildcard)
CORS_ORIGINS=https://your-domain.example

# Trusted Proxy & Rate Limiting
TRUST_PROXY_HEADERS=true
AUTH_RATE_LIMIT_ENABLED=true
AUTH_RATE_LIMIT_WINDOW_SECONDS=60
AUTH_RATE_LIMIT_MAX_REQUESTS=10

# Caddy Public Hostname & Immutable Release Images
PUBLIC_DOMAIN=your-domain.example
BACKEND_IMAGE=your-dockerhub-user/accommodation-backend
FRONTEND_IMAGE=your-dockerhub-user/accommodation-frontend
IMAGE_TAG=v1.0.0
